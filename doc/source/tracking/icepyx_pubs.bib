@article{tian2025,
  title = {Learning-{{Based Spatial Interpolation}} for {{Sparse Space Altimetry Measurements}}},
  author = {Tian, Xiangxi and Shan, Jie},
  year = 2025,
  journal = {IEEE Transactions on Geoscience and Remote Sensing},
  volume = {63},
  pages = {1--14},
  issn = {1558-0644},
  doi = {10.1109/TGRS.2025.3643406},
  urldate = {2026-03-09},
  abstract = {Generating continuous models from sparse measurements remains a key challenge in remote sensing due to the limited availability and high cost of dense data collection. Traditional interpolation methods, such as ordinary Kriging (OK) and natural neighbor (NN) interpolation, often degrade significantly in accuracy under sparse measurements. To address this, we introducea Transformer-based generative model for spatial interpolation (T-GMSI) approach, which leverages the Vision Transformer (ViT) architecture for high-quality spatial interpolation from sparse inputs. We then apply T-GMSI to the task of digital elevation model (DEM) generation using sparse spaceborne laser altimetry data. Results show that T-GMSI maintains high accuracy even with over 70\% data sparsity and generalizes well across diverse landscapes without requiring fine-tuning. Compared with baseline methods, T-GMSI reduces root-mean-square error (RMSE) by 40\% and 25\% over OK and NN interpolation, respectively, on airborne lidar datasets, and by 23\% and 10\% on spaceborne laser altimeter data. It also outperforms a state-of-the-art conditional generative adversarial networkconditional encoder--decoder generative adversarial neural network (CEDGAN), improving RMSE by 35\% and 20\% for airborne and spaceborne data, respectively. The study highlights the potential of learning-based interpolation methods for improving Earth observation modeling with sparse and incomplete remote sensing data.},
  keywords = {Accuracy,Altimetry,and land Elevation Satellite-2 (ICESat-2),Cloud,Computational modeling,Computer vision,Data models,Earth,Feature extraction,Generative adversarial networks,Generative model,Global Ecosystem Dynamics Investigation (GEDI),Ice,icepyx,Interpolation,space altimetry,sparse sampling,spatial interpolation,Transformers},
}


